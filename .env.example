DASHSCOPE_EMBEDDING_TIMEOUT_SECONDS=3
DASHSCOPE_EMBEDDING_BATCH_SIZE=10
DASHSCOPE_EMBEDDING_CACHE_TTL_SECONDS=600
DASHSCOPE_EMBEDDING_CACHE_MAX_ENTRIES=256
DASHSCOPE_RERANK_CANDIDATE_LIMIT=20
