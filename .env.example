GBRAIN_QUERY_CACHE_TTL_SECONDS=300
GBRAIN_CIRCUIT_FAILURE_THRESHOLD=3
GBRAIN_CIRCUIT_COOLDOWN_SECONDS=30
GBRAIN_IMPORT_TIMEOUT_SECONDS=600
GBRAIN_IMPORT_ON_COMPILE=false
GBRAIN_IMPORT_NO_EMBED=true
